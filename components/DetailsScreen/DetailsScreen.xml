<!-- node that renders details screen. handles start of video playback -->
<component name="DetailsScreen" extends="Group" initialFocus="Buttons">
  <children>
    <Group id="DetailsChrome">

    <!-- Background poster -->
    <Poster
      id="Background"
      width="1920"
      height="1080" 
      loadDisplayMode="scaleToZoom"
      />

    <Animation
      id="fadeinAnimation"
      repeat="false"
      duration="0.3">
      <FloatFieldInterpolator
        id="fadeInBackgroundInterpolator"
        key="[0.0, 1.0]"
        keyValue="[0.0, 1.0]"
        fieldToInterp="Background.opacity"/>
    </Animation>

    <Animation
      id="fadeoutAnimation"
      repeat="false"
      duration="0.3">
      <FloatFieldInterpolator
        id="fadeOutBackgroundInterpolator"
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="Background.opacity"/>
    </Animation>

    <!-- Background fade -->
    <Rectangle
      translation="[0,0]"
      width="1920"
      height="1080"
      color="0x000000"
      opacity="0.38" />

    <Label text="DETAILS" translation="[96, 54]" width="300" height="30"
      font="font:SmallBoldSystemFont" color="0x35C2FFFF" />

    <Label
      id="TitleLabel"
      translation="[96, 88]"
      width="1300"
      height="70"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />

    <!-- Readability band -->
    <Rectangle
      id="HUDRectangle"
      color="0x000000FF"
      width="1920"
      height="510"
      translation="[0, 570]"
      opacity="0.90" />

    <!-- Item poster -->
    <Poster
      id="Poster"
      translation="[96, 610]"
      width="270"
      height="405"
      loadDisplayMode="scaleToFit" />

    <!-- Backplate to keep text readable over bright key art -->
    <Rectangle
      id="DescriptionBackplate"
      translation="[385, 600]"
      width="930"
      height="390"
      color="0x000000"
      opacity="0.0" />

    <!-- Item description -->
    <MediaDescription
      id="Description"
      translation="[425, 625]"
      itemSpacings="[7, 16]" />

    <!-- Control buttons (Button List) -->
    <LabelList
      id="Buttons"
      translation="[1390,665]"
      color="0xFFFFFFFF"
      focusedColor="0x11151BFF"
      numRows="7"
      vertFocusAnimationStyle="floatingFocus"
      itemSpacing="[0,25]"
      itemSize="[320, 40]" />

    <Label
      id="PlaybackStatus"
      translation="[1390,820]"
      width="420"
      height="130"
      wrap="true"
      numLines="3"
      font="font:SmallSystemFont"
      color="0xD0D4DDFF"
      visible="false" />

    <!-- Resolution selector modal -->
    <Rectangle
      id="ResolutionBackdrop"
      translation="[0,0]"
      width="1920"
      height="1080"
      color="0x000000"
      opacity="0.5"
      visible="false" />

    <Rectangle
      id="ResolutionPanel"
      translation="[620,220]"
      width="680"
      height="430"
      color="0x171B22FF"
      visible="false" />

    <Label
      id="ResolutionTitle"
      text="Choose quality"
      translation="[700,255]"
      width="520"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF"
      visible="false" />

    <LabelList id="ResolutionList"
      translation="[700,340]"
      color="0xFFFFFFFF"
      focusedColor="0x11151BFF"
      numRows="5"
      vertFocusAnimationStyle="floatingFocus"
      itemSpacing="[0,20]"
      itemSize="[500, 56]"
      visible="false" />

    <LoadingIndicator
      id="LoadingIndicator"
      centered="true"
      width="1920"
      height="1080"
      text="Loading Streams..."
      fadeInterval="0.5"
      backgroundOpacity="0.62"
      visible="false" />

    <!-- Playback preparation modal -->
    <Group
      id="PreparationOverlay"
      visible="false">
      <Rectangle
        width="1920"
        height="1080"
        color="0x05070AFF"
        opacity="0.78" />

      <Rectangle
        translation="[560,330]"
        width="800"
        height="390"
        color="0x11151BFF" />

      <Rectangle
        translation="[560,330]"
        width="800"
        height="4"
        color="0x35C2FFFF" />

      <LoadingIndicator
        id="PreparationSpinner"
        centered="false"
        translation="[635,395]"
        width="72"
        height="72"
        imageWidth="60"
        imageHeight="60"
        text=""
        spinInterval="1.5"
        backgroundOpacity="0" />

      <Label
        text="STARTING PLAYBACK"
        translation="[745,382]"
        width="520"
        height="28"
        font="font:SmallBoldSystemFont"
        color="0x35C2FFFF" />

      <Label
        id="PreparationTitle"
        text="Preparing stream"
        translation="[745,420]"
        width="520"
        height="55"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF" />

      <Label
        id="PreparationMessage"
        text="Connecting to the selected source"
        translation="[745,482]"
        width="570"
        height="34"
        font="font:SmallSystemFont"
        color="0xB7BDC8FF" />

      <Rectangle
        translation="[640,565]"
        width="640"
        height="8"
        color="0x303640FF" />

      <Rectangle
        id="PreparationProgress"
        translation="[640,565]"
        width="0"
        height="8"
        color="0x35C2FFFF" />

      <Label
        id="PreparationSource"
        text="Source 1 of 1"
        translation="[640,595]"
        width="320"
        height="32"
        font="font:SmallBoldSystemFont"
        color="0xFFFFFFFF" />

      <Label
        id="PreparationHint"
        text="Press Back to cancel"
        translation="[960,595]"
        width="320"
        height="32"
        horizAlign="right"
        font="font:SmallSystemFont"
        color="0x8E96A3FF" />
    </Group>
    </Group>

    <!-- Playback node -->
    <Video
      id="VideoPlayer"
      visible="false"
      translation="[0, 0]"
      width="1920"
      height="1080" />

  </children>

    <interface>
      <!-- Button press handler -->
      <field id="itemSelected" type="integer" alwaysnotify="true" alias="Buttons.itemSelected" />
      <!-- Playback flag -->
      <field id="videoPlayerVisible" type="bool" alwaysnotify="true" alias="VideoPlayer.visible" />
      <!-- Content fields -->
      <field id="content" type="node" alwaysnotify="true" onChange="OnContentChange" />
    </interface>

    <!-- main handler -->
    <script type="text/brightscript" uri="pkg:/source/apiConfig.brs" />
    <script type="text/brightscript" uri="pkg:/components/DetailsScreen/DetailsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/WatchlistHelper.brs" />
</component>


