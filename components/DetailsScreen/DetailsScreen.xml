<!-- node that renders details screen. handles start of video playback -->
<component name="DetailsScreen" extends="Group" initialFocus="Buttons">
  <children>

    <!-- Background poster -->
    <Poster
      id="Background"
      width="1920"
      height="1080" 
      loadDisplayMode="scaleToZoom"
      />

    <Animation
      id="fadeinAnimation"
      repeat="false"
      duration="0.3">
      <FloatFieldInterpolator
        id="backgroundInterpolator"
        key="[0.0, 1.0]"
        keyValue="[0.0, 1.0]"
        fieldToInterp="Background.opacity"/>
    </Animation>

    <Animation
      id="fadeoutAnimation"
      repeat="false"
      duration="0.3">
      <FloatFieldInterpolator
        id="backgroundInterpolator"
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="Background.opacity"/>
    </Animation>

    <!-- Background fade -->
    <Rectangle
      translation="[0,0]"
      width="1920"
      height="1080"
      color="0x000000"
      opacity="0.62" />

    <Label
      id="TitleLabel"
      translation="[100, 70]"
      width="1300"
      height="70"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />

    <!-- Control buttons (Button List) -->
    <LabelList
      id="Buttons"
      translation="[1420,430]"
      color="0xFFFFFFFF"
      focusedColor="0x333333FF"
      numRows="7"
      vertFocusAnimationStyle="floatingFocus"
      itemSpacing="[0,25]"
      itemSize="[320, 40]" />

    <!-- Semi-transparent backdrop for resolution selector -->
    <Rectangle
      id="ResolutionBackdrop"
      translation="[0,0]"
      width="1920"
      height="1080"
      color="0x000000"
      opacity="0.5"
      visible="false"
      />

    <Rectangle
      id="ResolutionPanel"
      translation="[620,220]"
      width="680"
      height="430"
      color="0x17191FFF"
      visible="false" />

    <Label
      id="ResolutionTitle"
      text="Choose quality"
      translation="[700,255]"
      width="520"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF"
      visible="false" />

    <!-- Resolution selector list (modal overlay) -->
    <LabelList id="ResolutionList"
      translation="[700,340]"
      color="0xFFFFFFFF"
      focusedColor="0x333333FF"
      numRows="5"
      vertFocusAnimationStyle="floatingFocus"
      itemSpacing="[0,20]"
      itemSize="[500, 56]"
      visible="false"
      />

    <LoadingIndicator
      id="LoadingIndicator"
      centered="true"
      text="Loading Streams..."
      fadeInterval="0.5"
      visible="false" />

    <Label
      id="PlaybackStatus"
      translation="[1380,660]"
      width="420"
      height="130"
      wrap="true"
      numLines="3"
      font="font:SmallSystemFont"
      color="0xD0D4DDFF"
      visible="false" />

    <!-- Readability band -->
    <Rectangle
      id="HUDRectangle"
      color="0x000000FF"
      width="1920"
      height="480"
      translation="[0, 600]"
      opacity="0.88" />

    <!-- Item poster -->
    <Poster
      id="Poster"
      translation="[100, 625]"
      width="260"
      height="390"
      loadDisplayMode="scaleToFit" />

    <!-- Backplate to keep text readable over bright key art -->
    <Rectangle
      id="DescriptionBackplate"
      translation="[390, 620]"
      width="930"
      height="370"
      color="0x000000"
      opacity="0.65" />

    <!-- Item description -->
    <MediaDescription
      id="Description"
      translation="[430, 650]"
      itemSpacings="[7, 16]" />

    <!-- Playback node -->
    <Video
      id="VideoPlayer"
      visible="false"
      translation="[0, 0]"
      width="1920"
      height="1080" />

  </children>

    <interface>
      <!-- Button press handler -->
      <field id="itemSelected" type="integer" alwaysnotify="true" alias="Buttons.itemSelected" />
      <!-- Playback flag -->
      <field id="videoPlayerVisible" type="bool" alwaysnotify="true" alias="VideoPlayer.visible" />
      <!-- Content fields -->
      <field id="content" type="node" alwaysnotify="true" onChange="OnContentChange" />
    </interface>

    <!-- main handler -->
    <script type="text/brightscript" uri="pkg:/source/apiConfig.brs" />
    <script type="text/brightscript" uri="pkg:/components/DetailsScreen/DetailsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/WatchlistHelper.brs" />
</component>


