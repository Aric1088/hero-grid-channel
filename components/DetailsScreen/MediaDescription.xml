<!-- node - description of the content item -->
<component name="MediaDescription" extends="LayoutGroup">
  <children>
    <Label
      id="Title"
      color="0xFFFFFFFF"
      font="font:LargeBoldSystemFont"
      width="900"
      height="58"
      text=""/>

    

    <Label
      id="Description"
      color="0xD5D9E1FF"
      wrap="true"
      width="880"
      height="250"
      numLines="6"
      font="font:MediumSystemFont"
      lineSpacing="7"
      text=""/>
  </children>

  <interface>
    <!-- Content node -->
    <field id="Content"     type="node" onChange="OnContentChanged"/>
  </interface>

  <!-- main handler -->
  <script type="text/brightscript" uri="pkg:/components/DetailsScreen/MediaDescription.brs" />

</component>
