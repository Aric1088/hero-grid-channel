<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeSelectScreen" extends="Group" initialFocus="episodeList">

  <interface>
    <field id="item" type="node" />
    <field id="contentSelected" type="node" />
    <field id="rowItemSelected" type="intarray" alias="episodeList.rowItemSelected" alwaysNotify="true" />
    <function name="selectFocusedEpisode" />
    <function name="prepareForDisplay" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/apiConfig.brs" />
  <script type="text/brightscript" uri="EpisodeSelectScreen.brs" />

  <children>
    <Rectangle width="1920" height="1080" color="0x090B10FF" />
    <Label
      text="SERIES"
      translation="[96, 62]"
      width="500"
      height="30"
      font="font:SmallBoldSystemFont"
      color="0x35C2FFFF" />
    <Label
      id="seriesTitle"
      translation="[96, 96]"
      width="1100"
      height="60"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />
    <Label
      id="seriesDesc"
      translation="[96, 162]"
      font="font:SmallSystemFont"
      color="0xB8BEC9FF"
      wrap="true"
      width="1180"
      height="72"
      numLines="3" />
    <Label
      id="episodeHint"
      text="Choose an episode"
      translation="[1515, 202]"
      width="300"
      horizAlign="right"
      font="font:SmallSystemFont"
      color="0x7E8795FF" />
    <Label
      id="statusLabel"
      translation="[96, 214]"
      width="1500"
      height="34"
      font="font:SmallBoldSystemFont"
      color="0xF0B95BFF"
      visible="false" />
    <RowList
      id="episodeList"
      itemComponentName="EpisodeItem"
      numRows="20"
      itemSize="[1920, 300]"
      rowHeights="[300,300,300,300,300,300,300,300,300,300,300,300,300,300,300,300,300,300,300,300]"
      rowItemSize="[[300, 220]]"
      rowItemSpacing="[[24, 0]]"
      showRowLabel="true"
      showRowCounter="false"
      rowLabelOffset="[[96, 42]]"
      focusXOffset="[96]"
      rowFocusAnimationStyle="floatingFocus"
      translation="[0, 250]"
      visible="false" />
    <LoadingIndicator
      id="loadingIndicator"
      centered="true"
      width="1920"
      height="1080"
      backgroundOpacity="0.15"
      text="Loading seasons..." />
  </children>
</component>
