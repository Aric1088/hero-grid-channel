<component name="HeroScreen" extends="Group" initialFocus="RowList">

  <children>
    <!-- For transition animation -->
    <FadingBackground
      id="Background"
      width="1920"
      height="1080"
      color="0x000000"
      ShadeOpacity="0.48" />

    <Rectangle
      width="1920"
      height="1080"
      color="0x07090DFF"
      opacity="0.28" />

    <Rectangle
      translation="[0, 300]"
      width="1920"
      height="780"
      color="0x07090DF2" />

    <Label
      id="HeroEyebrow"
      text="FEATURED"
      translation="[96, 154]"
      width="740"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x35C2FFFF" />

    <Label
      id="HeroTitle"
      translation="[96, 184]"
      width="980"
      height="60"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />

    <Label
      id="HeroDescription"
      translation="[96, 247]"
      width="980"
      height="64"
      numLines="2"
      wrap="true"
      font="font:SmallSystemFont"
      color="0xD5D9E1FF" />

    <!-- The main content -->
    <RowList
	    id="RowList"
      itemComponentName="customItem"
      focusXOffset="[96]"
      itemSize="[1920,340]"
      numRows="9"
      rowFocusAnimationStyle="floatingFocus"
      rowHeights="[340,340,340,340,340,340,340,340,340]"
      rowItemSize="[[175,248]]"
      rowItemSpacing="[[24,0]]"
      rowLabelOffset="[[96,44]]"
      showRowLabel="[true,true,true,true,true,true,true,true,true]"
      showRowCounter="[false,false,false,false]"
      translation="[0,340]"/>
  </children>

  <interface>
    <!-- Grid Content Node -->
    <field id="content" type="node" alias="RowList.content" />

    <!-- Row item selection handler -->
    <field id="rowItemSelected" type="intarray" alias="RowList.rowItemSelected" alwaysnotify="true"/>

    <!-- Row item focused handler - sets background image uri and focusedContent field -->
    <field id="itemFocused" type="intarray" alias="RowList.rowItemFocused" onChange="OnItemFocused"/>

    <!-- Interface to focused item (Content Node) -->
    <field id="focusedContent"  type="node"/>

    <!-- # of requests that have bad/no content (not a 200 response) -->
    <field id="numBadRequests" type="integer"/>
    
    <function name="loadCategory" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/HeroScreen/HeroScreen.brs" />

  <script type="text/brightscript" uri="pkg:/components/WatchlistHelper.brs" />
</component>
