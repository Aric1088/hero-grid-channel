<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group" initialFocus="saveButton">

  <children>
    <Rectangle 
      id="background" 
      width="1920" 
      height="1080" 
      color="0x0F0F14E6" 
      translation="[0,0]" />

    <LayoutGroup translation="[100, 120]" itemSpacings="[20]">
      <!-- Header -->
      <Label text="SpamFilms Server Settings" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      
      <!-- Instructions -->
      <Label text="Type your SpamFilms backend server URL below (e.g. http://192.168.1.100:8080 or https://your-server.ddns.net:8080):" font="font:MediumSystemFont" color="0xAAAAAAFF" />
      
      <!-- Current Server Value -->
      <Label id="currentUrlLabel" text="Active Server: https://spamfilms.ddns.net:8080" font="font:MediumBoldSystemFont" color="0x8B5CF6FF" />
      
      <!-- Keyboard to Type URL -->
      <Keyboard id="keyboard" />
      
      <!-- Buttons -->
      <LayoutGroup layoutDirection="horiz" itemSpacings="[30]">
        <Button 
          id="saveButton" 
          text="Save &amp; Test Connection" 
          minWidth="350"
          showFocusFootprint="true"
        />
        <Button 
          id="resetButton" 
          text="Reset to Default" 
          minWidth="250"
          showFocusFootprint="true"
        />
      </LayoutGroup>
      
      <!-- Status Output -->
      <Label id="statusLabel" text="" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
    </LayoutGroup>
    
    <!-- Test Task Node -->
    <SpamFilmsFetcher id="testFetcher" />
  </children>
  
  <script type="text/brightscript" uri="pkg:/source/apiConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/SettingsScreen/SettingsScreen.brs" />
</component>
