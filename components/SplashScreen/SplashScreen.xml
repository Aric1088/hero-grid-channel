<?xml version="1.0" encoding="utf-8" ?>

<component name="SplashScreen" extends="Group">
  <interface>
    <field id="ready" type="boolean" onChange="onReady" />
    <field id="animationComplete" type="boolean" />
  </interface>

  <children>
    <!-- Background -->
    <Rectangle
      id="background"
      width="1920"
      height="1080"
      color="0x090B10FF"
      opacity="1.0" />
    
    <!-- Logo/Title -->
    <Label
      id="title"
      text="SpamFilms"
      translation="[0, 405]"
      width="1920"
      height="90"
      horizAlign="center"
      vertAlign="center"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF"
      opacity="1.0" />
    
    <!-- Subtitle -->
    <Label
      id="subtitle"
      text="Movies and television, one library"
      translation="[0, 520]"
      width="1920"
      height="60"
      horizAlign="center"
      vertAlign="center"
      font="font:MediumSystemFont"
      color="0xA9AFBAFF"
      opacity="1.0" />
    <Rectangle id="accent" translation="[900, 500]" width="120" height="5"
      color="0x35C2FFFF" opacity="1.0" />
    
    <!-- Fade out animation -->
    <Animation
      id="fadeOut"
      repeat="false"
      duration="1.0">
      <FloatFieldInterpolator
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="background.opacity" />
      <FloatFieldInterpolator
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="title.opacity" />
      <FloatFieldInterpolator
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="subtitle.opacity" />
      <FloatFieldInterpolator
        key="[0.0, 1.0]"
        keyValue="[1.0, 0.0]"
        fieldToInterp="accent.opacity" />
    </Animation>
  </children>
  
  <script type="text/brightscript" uri="SplashScreen.brs" />
</component>
