<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="keyboard">

  <interface>
    <!-- Triggers when item is selected -->
    <field id="contentSelected" type="node" />
    
    <!-- Context Aware Search: "movies" or "series" -->
    <function name="setSearchContext" />
    <function name="resetState" />
    <function name="restoreResultsFocus" />
  </interface>

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/Content/SpamFilmsApi.brs" />

  <children>
    <Rectangle
      id="background"
      width="1920"
      height="1080"
      color="0x090B10FF" />

    <Label
      text="Search"
      translation="[96, 55]"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />

    <Label
      id="searchSubtitle"
      text="Find movies and TV shows"
      translation="[96, 112]"
      font="font:MediumSystemFont"
      color="0xA9ADB7FF" />

    <Keyboard
      id="keyboard"
      translation="[96, 155]" />

    <Rectangle
      id="searchActionPanel"
      translation="[1510, 470]"
      width="310"
      height="305"
      color="0x171B22FF" />

    <Button
      id="searchButton"
      text="Search"
      translation="[1540, 510]"
      minWidth="250"
      showFocusFootprint="true" />

    <Label
      id="statusLabel"
      text="Enter at least 2 characters to search."
      translation="[1540, 630]"
      width="250"
      wrap="true"
      numLines="4"
      font="font:MediumSystemFont"
      color="0xA9ADB7FF" />

    <Label
      id="resultsHeading"
      text="Results"
      translation="[96, 220]"
      font="font:MediumBoldSystemFont"
      color="0xFFFFFFFF"
      visible="false" />

    <RowList
      id="resultsGrid"
      itemComponentName="customItem"
      translation="[0, 260]"
      focusXOffset="[96]"
      itemSize="[1920, 390]"
      numRows="2"
      rowHeights="[390, 390]"
      rowItemSize="[[190, 285]]"
      rowItemSpacing="[[24, 0]]"
      rowLabelOffset="[[96, 42]]"
      showRowLabel="[true, true]"
      showRowCounter="[false, false]"
      rowFocusAnimationStyle="floatingFocus"
      visible="false" />
    
    <!-- Loading Spinner -->
    <LoadingIndicator 
      id="loadingIndicator" 
      width="1920"
      height="1080"
      centered="true"
      backgroundOpacity="0.45"
      text="Searching..."
      fadeInterval="0.5"
    />
  </children>
</component>
