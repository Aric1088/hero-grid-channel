<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group" initialFocus="keyboard">

  <interface>
    <!-- Triggers when item is selected -->
    <field id="contentSelected" type="node" />
    
    <!-- Context Aware Search: "movies" or "series" -->
    <function name="setSearchContext" />
    <function name="resetState" />
  </interface>

  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/Content/SpamFilmsApi.brs" />

  <children>
    <Rectangle
      id="background"
      width="1920"
      height="1080"
      color="0x090B10FF" />

    <Label
      text="Search"
      translation="[96, 55]"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" />

    <Label
      id="searchSubtitle"
      text="Find movies and TV shows"
      translation="[96, 112]"
      font="font:MediumSystemFont"
      color="0xA9ADB7FF" />

    <Keyboard
      id="keyboard"
      translation="[96, 155]" />

    <Button
      id="searchButton"
      text="Search"
      translation="[1570, 500]"
      minWidth="220"
      showFocusFootprint="true" />

    <Label
      id="statusLabel"
      text="Enter at least 2 characters to search."
      translation="[1500, 620]"
      width="300"
      wrap="true"
      numLines="4"
      font="font:MediumSystemFont"
      color="0xA9ADB7FF" />

    <Label
      id="resultsHeading"
      text="Results"
      translation="[96, 220]"
      font="font:MediumBoldSystemFont"
      color="0xFFFFFFFF"
      visible="false" />

    <RowList
      id="resultsGrid"
      itemComponentName="customItem"
      translation="[0, 260]"
      focusXOffset="[96]"
      itemSize="[1920, 380]"
      numRows="2"
      rowHeights="[380, 380]"
      rowItemSize="[[210, 315]]"
      rowItemSpacing="[[28, 0]]"
      rowLabelOffset="[[96, 0]]"
      showRowLabel="[true, true]"
      showRowCounter="[false, false]"
      rowFocusAnimationStyle="floatingFocus"
      visible="false" />
    
    <!-- Loading Spinner -->
    <LoadingIndicator 
      id="loadingIndicator" 
      translation="[1390, 480]"
      text="Searching..."
      fadeInterval="0.5"
    />
  </children>
</component>
