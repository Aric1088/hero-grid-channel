<?xml version="1.0" encoding="utf-8" ?>
<component name="ProfileSelectScreen" extends="Group" initialFocus="profileMarkupGrid">

  <interface>
    <field id="profileSelected" type="assocarray" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle 
      id="bg" 
      width="1920" 
      height="1080" 
      color="0x090B10FF" />

    <Label text="SPAMFILMS" translation="[96, 62]" width="360" height="48"
      font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
    <Rectangle translation="[96, 116]" width="72" height="4" color="0x35C2FFFF" />
      
    <Label 
      text="Who's watching?" 
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF" 
      horizAlign="center" 
      vertAlign="center"
      translation="[0, 245]"
      width="1920"
      height="80" />

    <Label text="Choose a profile to continue" font="font:MediumSystemFont"
      color="0x939BA8FF" horizAlign="center" translation="[0, 320]"
      width="1920" height="50" />
    
    <MarkupGrid 
      id="profileMarkupGrid"
      itemComponentName="ProfileGridItem"
      itemSize="[250, 330]"
      numColumns="4"
      numRows="1"
      itemSpacing="[44, 0]"
      translation="[390, 410]"
      drawFocusFeedback="false"
    />
  </children>

  <script type="text/brightscript" uri="pkg:/components/ProfileSelectScreen/ProfileSelectScreen.brs" />
</component>
