<?xml version="1.0" encoding="utf-8" ?>
<component name="ProfileGridItem" extends="Group">

  <interface>
    <field id="itemContent" type="node" onChange="onContentChange" />
    <field id="gridHasFocus" type="boolean" onChange="onFocusChange" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
  </interface>

  <children>
    <Rectangle id="shadow" width="218" height="218" color="0x00000080" translation="[20, 28]" />
    <Rectangle id="focusBorder" width="230" height="230" color="0x35C2FFFF"
      translation="[10, 10]" visible="false" />
    <Rectangle id="cardFrame" width="220" height="220" color="0x273443FF"
      translation="[15, 15]" />

    <Label 
      id="avatarLabel" 
      text="AV" 
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF"
      width="250"
      height="250"
      horizAlign="center" 
      vertAlign="center"
      translation="[0, 0]"
    />

    <Label 
      id="nameLabel" 
      text="Name" 
      font="font:LargeBoldSystemFont"
      color="0xAAAAAAFF" 
      horizAlign="center"
      width="250"
      translation="[0, 258]"
    />
  </children>

  <script type="text/brightscript" uri="pkg:/components/ProfileSelectScreen/ProfileGridItem.brs" />
</component>
